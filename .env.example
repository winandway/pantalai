# Variables que van en el panel de YaDominios Cloud (nunca en el repositorio)
# Clave secreta de Cloudflare Turnstile (opcional: sin ella el escudo se apaga solo)
TURNSTILE_SECRET=
# Clave pública de Turnstile (va al navegador)
TURNSTILE_SITE_KEY=
# Llave del hosting de YaDominios Cloud (servidor MCP), sitio pantalai
PANTALAI_YADOMINIOS_LLAVE=
# Token de la API de consultas a la base del sitio pantalai
PANTALAI_DB_TOKEN=
