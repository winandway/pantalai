{
  "name": "pantalai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PANTALAI: graba tu pantalla y cámara, y comparte con un enlace. Corre en YaDominios Cloud.",
  "scripts": {
    "dev": "vite",
    "dev:servidor": "npm run build && wrangler dev --local --port 8787",
    "build": "vite build && node scripts/construir-servidor.mjs && node scripts/empaquetar.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "audit": "npm audit --audit-level=high --omit=dev",
    "secretos": "gitleaks detect --no-banner --redact || gitleaks git --no-banner --redact .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@stripe/stripe-js": "^10.1.0",
    "fix-webm-duration": "^1.0.6",
    "hono": "^4.13.13",
    "mediabunny": "^1.61.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
